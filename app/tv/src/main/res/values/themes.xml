<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the root shell and app state are initialized -->
    <style name="TvSplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tv_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_magisk_padded</item>
        <item name="postSplashScreenTheme">@style/TvTheme</item>
    </style>

    <style name="TvTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
